  "flow": {
    "triggers": [
      {
        "id": "battery_level_above",
        "title": {
          "en": "Battery level changed and is above …",
          "nl": "Batterijniveau gewijzigd en boven …"
        },
        "titleFormatted": {
          "en": "Battery level changed and is above [[percentage]]%",
          "nl": "Batterijniveau gewijzigd en boven [[percentage]]%"
        },
        "hint": {
          "en": "Fires on every change of the battery level while the level is above the number you enter: with 80 it fires at 81, again at 82, and so on. It doesn't fire for 80 itself. Needs 'vehicle.drivetrain.batteryManagement.header' to be ticked in the stream selection of the BMW CarData portal.",
          "nl": "Gaat af bij elke wijziging van het batterijniveau zolang het niveau boven het ingevoerde getal ligt: bij 80 gaat het af bij 81, opnieuw bij 82, enzovoort. Bij 80 zelf gaat het niet af. Hiervoor moet 'vehicle.drivetrain.batteryManagement.header' zijn aangevinkt in de streamselectie van het BMW CarData-portaal."
        },
        "tokens": [
          {
            "name": "battery",
            "type": "number",
            "title": {
              "en": "Battery level",
              "nl": "Batterijniveau"
            },
            "example": 85
          }
        ],
        "args": [
          {
            "name": "device",
            "type": "device",
            "filter": "driver_id=bmw|mini"
          },
          {
            "name": "percentage",
            "type": "number",
            "title": {
              "en": "Percentage",
              "nl": "Percentage"
            },
            "placeholder": {
              "en": "80"
            },
            "min": 0,
            "max": 100,
            "step": 1
          }
        ]
      },
      {
        "id": "car_locked",
        "title": {
          "en": "The car was locked",
          "nl": "De auto is vergrendeld"
        },
        "hint": {
          "en": "Fires when the car goes from unlocked to locked, based on the door status BMW CarData reports. BMW only sends this status now and then, so the flow can run late. Needs 'vehicle.cabin.door.status' to be ticked in the stream selection of the BMW CarData portal.",
          "nl": "Gaat af wanneer de auto van ontgrendeld naar vergrendeld gaat, op basis van de deurstatus die BMW CarData meldt. BMW stuurt deze status maar af en toe, dus de flow kan te laat starten. Hiervoor moet 'vehicle.cabin.door.status' zijn aangevinkt in de streamselectie van het BMW CarData-portaal."
        },
        "args": [
          {
            "name": "device",
            "type": "device",
            "filter": "driver_id=bmw|mini"
          }
        ]
      },
      {
        "id": "car_unlocked",
        "title": {
          "en": "The car was unlocked",
          "nl": "De auto is ontgrendeld"
        },
        "hint": {
          "en": "Fires when the car goes from locked to unlocked, based on the door status BMW CarData reports. BMW only sends this status now and then, so the flow can run late. Needs 'vehicle.cabin.door.status' to be ticked in the stream selection of the BMW CarData portal.",
          "nl": "Gaat af wanneer de auto van vergrendeld naar ontgrendeld gaat, op basis van de deurstatus die BMW CarData meldt. BMW stuurt deze status maar af en toe, dus de flow kan te laat starten. Hiervoor moet 'vehicle.cabin.door.status' zijn aangevinkt in de streamselectie van het BMW CarData-portaal."
        },
        "args": [
          {
            "name": "device",
            "type": "device",
            "filter": "driver_id=bmw|mini"
          }
        ]
      },
      {
        "id": "charging_cable_connected",
        "title": {
          "en": "A charging cable was plugged in",
          "nl": "Er is een laadkabel aangesloten"
        },
        "hint": {
          "en": "Fires when a charging cable is plugged into the car, based on the charging port status BMW CarData reports. Needs 'vehicle.body.chargingPort.status' to be ticked in the stream selection of the BMW CarData portal.",
          "nl": "Gaat af wanneer er een laadkabel op de auto wordt aangesloten, op basis van de laadpoortstatus die BMW CarData meldt. Hiervoor moet 'vehicle.body.chargingPort.status' zijn aangevinkt in de streamselectie van het BMW CarData-portaal."
        },
        "args": [
          {
            "name": "device",
            "type": "device",
            "filter": "driver_id=bmw|mini"
          }
        ]
      },
      {
        "id": "charging_cable_disconnected",
        "title": {
          "en": "The charging cable was unplugged",
          "nl": "De laadkabel is losgekoppeld"
        },
        "hint": {
          "en": "Fires when the charging cable is unplugged from the car, based on the charging port status BMW CarData reports. Needs 'vehicle.body.chargingPort.status' to be ticked in the stream selection of the BMW CarData portal.",
          "nl": "Gaat af wanneer de laadkabel van de auto wordt losgekoppeld, op basis van de laadpoortstatus die BMW CarData meldt. Hiervoor moet 'vehicle.body.chargingPort.status' zijn aangevinkt in de streamselectie van het BMW CarData-portaal."
        },
        "args": [
          {
            "name": "device",
            "type": "device",
            "filter": "driver_id=bmw|mini"
          }
        ]
      },
      {
        "id": "charging_flap_locked",
        "title": {
          "en": "The charging flap was locked",
          "nl": "De laadklep is vergrendeld"
        },
        "hint": {
          "en": "Fires when the charging flap goes from unlocked to locked, based on the data BMW CarData reports. Needs 'vehicle.body.flap.isLocked' to be ticked in the stream selection of the BMW CarData portal.",
          "nl": "Gaat af wanneer de laadklep van ontgrendeld naar vergrendeld gaat, op basis van de gegevens die BMW CarData meldt. Hiervoor moet 'vehicle.body.flap.isLocked' zijn aangevinkt in de streamselectie van het BMW CarData-portaal."
        },
        "args": [
          {
            "name": "device",
            "type": "device",
            "filter": "driver_id=bmw|mini"
          }
        ]
      },
      {
        "id": "charging_flap_unlocked",
        "title": {
          "en": "The charging flap was unlocked",
          "nl": "De laadklep is ontgrendeld"
