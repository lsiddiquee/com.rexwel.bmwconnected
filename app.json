    "conditions": [
      {
        "id": "battery_percentage",
        "title": {
          "en": "Battery charge is !{{less than|more than or equal to}} ...",
          "nl": "Batterijlading is !{{minder dan|meer dan of gelijk aan}} ..."
        },
        "titleFormatted": {
          "en": "Battery charge is !{{less than|more than or equal to}} '[[battery_charge_test]]'%",
          "nl": "Batterijlading is !{{minder dan|meer dan of gelijk aan}} '[[battery_charge_test]]'%"
        },
        "hint": {
          "en": "Checks if battery charge is less/more than or equal to a given percentage.",
          "nl": "Controleert of de batterijlading minder/meer dan of gelijk is aan een gegeven percentage."
        },
        "args": [
          {
            "type": "number",
            "name": "battery_charge_test",
            "title": {
              "en": "Charge",
              "nl": "Lading"
            },
            "placeholder": {
              "en": "50"
            },
            "min": 0,
            "max": 100
          },
          {
            "name": "device",
            "type": "device",
            "filter": "driver_id=bmw|mini"
          }
        ]
      },
      {
        "id": "car_data_fresh",
        "title": {
          "en": "Car data !{{was|wasn't}} updated recently",
          "nl": "Autodata !{{is|is niet}} onlangs bijgewerkt"
        },
        "titleFormatted": {
          "en": "Car data !{{was|wasn't}} updated in the last [[minutes]] minutes",
          "nl": "Autodata !{{is|is niet}} bijgewerkt in de afgelopen [[minutes]] minuten"
        },
        "hint": {
          "en": "Checks whether the car measured its newest data (received by stream or API poll) within the given number of minutes. Old data that is delivered late does not count as new.",
          "nl": "Controleert of de auto zijn nieuwste data heeft gemeten (ontvangen via stream of API-poll) binnen het opgegeven aantal minuten. Oude data die laat wordt afgeleverd telt niet als nieuw."
        },
        "args": [
          {
            "type": "number",
            "name": "minutes",
            "title": {
              "en": "Minutes",
              "nl": "Minuten"
            },
            "placeholder": {
              "en": "30",
              "nl": "30"
            },
            "min": 1,
            "max": 1440,
